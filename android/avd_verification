#!/usr/bin/env bash
# android/avd_verification — Autonomous AVD execution and validation script (AVD-001)
# Strictly adheres to ~/.agents/skills/android-emulator/SKILL.md rules.
set -euo pipefail

SERIAL="emulator-5554"
PACKAGE="com.compozy.app.compozy_app"
ACTIVITY="com.compozy.app.compozy_app.MainActivity"
APK_PATH="build/app/outputs/flutter-apk/app-debug.apk"
SCREENSHOT_DIR="/tmp/compozy-app-screenshots/v2"
SCREENSHOT_FILE="$SCREENSHOT_DIR/compozy_v2_launch.png"

echo "=== [AVD-001] testAutonomousAvdExecution: Starting Autonomous Android AVD Run ==="

# 1. Verify APK existence
if [ ! -f "$APK_PATH" ]; then
  echo "APK not found at $APK_PATH, building debug APK..."
  flutter build apk --debug
fi
echo "✓ Debug APK present at $APK_PATH ($(stat -c%s "$APK_PATH") bytes)"

# 2. Launch headless Android emulator via avd helper
echo "Launching headless AVD (Pixel_API36) via 'avd up'..."
avd up

# 3. Verify gate: sys.boot_completed=1
echo "Verifying boot_completed gate on $SERIAL..."
BOOT_STATUS="$(adb -s "$SERIAL" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')"
if [ "$BOOT_STATUS" != "1" ]; then
  echo "ERRO: $SERIAL boot_completed=$BOOT_STATUS (expected 1)" >&2
  exit 1
fi
echo "✓ $SERIAL boot_completed=1 (AVD fully initialized)"

# 4. Show AVD status and memory
avd status
adb -s "$SERIAL" shell grep MemTotal /proc/meminfo | tr -d '\r'

# 5. Install debug APK
echo "Installing $APK_PATH on $SERIAL..."
adb -s "$SERIAL" install -r "$APK_PATH"
echo "✓ APK installed successfully"

# 6. Launch Compozy App
echo "Starting $PACKAGE/$ACTIVITY on $SERIAL..."
adb -s "$SERIAL" shell am start -n "$PACKAGE/$ACTIVITY"
echo "Waiting for Flutter engine and UI initialization..."
sleep 8

# 7. Verify app process execution
echo "Verifying app process..."
APP_PID="$(adb -s "$SERIAL" shell pidof "$PACKAGE" 2>/dev/null | tr -d '\r' || true)"
if [ -z "$APP_PID" ]; then
  echo "ERRO: Process $PACKAGE is not running!" >&2
  adb -s "$SERIAL" logcat -d | tail -n 40 >&2
  exit 1
fi
echo "✓ App running with PID: $APP_PID"

# 8. Capture verification screenshot
echo "Capturing screenshot to $SCREENSHOT_FILE..."
mkdir -p "$SCREENSHOT_DIR"
adb -s "$SERIAL" exec-out screencap -p > "$SCREENSHOT_FILE"

if [ ! -s "$SCREENSHOT_FILE" ]; then
  echo "ERRO: Screenshot file is empty or was not created!" >&2
  exit 1
fi
echo "✓ Screenshot captured successfully ($(stat -c%s "$SCREENSHOT_FILE") bytes)"
file "$SCREENSHOT_FILE"

# 9. Clean shutdown of AVD
echo "Shutting down AVD cleanly via 'avd down'..."
avd down
echo "✓ AVD shut down cleanly"

echo "=== [AVD-001] testAutonomousAvdExecution: COMPLETED SUCCESSFULLY ==="
